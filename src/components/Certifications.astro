---
const certs = [
  { name: 'ServiceNow Certified Technical Architect (CTA)', issuer: 'ServiceNow', highlight: true, color: 'violet' },
  { name: 'Architecture Excellence (ArchX)', issuer: 'ServiceNow', highlight: true, color: 'cyan' },
  { name: 'Certified Application Developer', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'Certified System Administrator', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – IT Service Management', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Event Management', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Discovery', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Application Portfolio Management', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Hardware Asset Management', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Vulnerability Response', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Human Resources', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'CIS – Software Asset Management', issuer: 'ServiceNow', highlight: false, color: 'cyan' },
  { name: 'ITIL Foundation in IT Service Management', issuer: 'AXELOS', highlight: false, color: 'amber' },
];

const awards = [
  {
    title: 'One IT Team Award',
    from: 'Senior Vice President, NetApp',
    date: 'Jun 2023',
    desc: 'End-to-end implementation of IT Vulnerability Response — awarded by Senior Vice President.',
    emoji: '🏆',
    color: 'amber',
  },
  {
    title: 'Spot Award',
    from: 'NetApp',
    date: 'Nov 2022',
    desc: 'Migration of Connect Chat to AWA + Agent Chat and implementation of Sidebar.',
    emoji: '⭐',
    color: 'cyan',
  },
  {
    title: 'Spot Award',
    from: 'NetApp',
    date: 'Jun 2022',
    desc: 'Implementation of Cloud Insights integration with ServiceNow.',
    emoji: '⭐',
    color: 'cyan',
  },
  {
    title: 'Spot Award',
    from: 'Infogain',
    date: 'Nov 2020',
    desc: 'End-to-end implementation of CSM module.',
    emoji: '⭐',
    color: 'violet',
  },
  {
    title: 'Budding Engineer Award',
    from: 'Infogain',
    date: 'May 2020',
    desc: 'Implementation of 10+ automation use cases on the ServiceNow platform.',
    emoji: '🌟',
    color: 'green',
  },
];

const colorMap: Record<string, { ring: string; dot: string }> = {
  violet: { ring: 'ring-violet-500/40', dot: 'bg-violet-400' },
  cyan:   { ring: 'ring-cyan-500/40',   dot: 'bg-cyan-400' },
  amber:  { ring: 'ring-amber-500/40',  dot: 'bg-amber-400' },
  green:  { ring: 'ring-green-500/40',  dot: 'bg-green-400' },
};
---

<section id="certifications" class="py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-500/30 bg-violet-500/10 text-violet-300 text-xs font-medium mb-6 font-['JetBrains_Mono'] uppercase tracking-widest">
        // certifications_&_awards
      </div>
      <h2 class="section-heading text-white">
        Credentials &amp; <span class="gradient-text">Recognition</span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Certifications -->
      <div class="reveal">
        <h3 class="font-bold text-white text-xl mb-6 flex items-center gap-3">
          <span class="text-2xl">📜</span> 13 Certifications
        </h3>

        <div class="grid grid-cols-2 gap-4 mb-4">
          {certs.filter(c => c.highlight).map(cert => (
            <div class={`card-surface rounded-2xl p-5 ring-1 ${colorMap[cert.color].ring} text-center`}>
              <div class="text-3xl mb-3">🏅</div>
              <p class="font-bold text-white text-sm leading-tight">{cert.name}</p>
              <p class="text-[#9b9aaa] text-xs mt-1">{cert.issuer}</p>
            </div>
          ))}
        </div>

        <div class="card-surface rounded-2xl p-5">
          <div class="space-y-2.5">
            {certs.filter(c => !c.highlight).map(cert => (
              <div class="flex items-center gap-3">
                <div class={`w-2 h-2 rounded-full shrink-0 ${colorMap[cert.color].dot}`}></div>
                <div class="flex-1 flex items-center justify-between gap-2">
                  <span class="text-sm text-[#9b9aaa]">{cert.name}</span>
                  <span class="text-xs px-2 py-0.5 rounded border border-white/10 text-[#9b9aaa] shrink-0">{cert.issuer}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Awards -->
      <div class="reveal" style="transition-delay: 0.2s">
        <h3 class="font-bold text-white text-xl mb-6 flex items-center gap-3">
          <span class="text-2xl">🏆</span> 5 Honor Awards
        </h3>

        <div class="space-y-4">
          {awards.map((award) => (
            <div class={`card-surface rounded-2xl p-5 ring-1 ${colorMap[award.color].ring} flex gap-4`}>
              <div class="text-2xl shrink-0">{award.emoji}</div>
              <div class="flex-1">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="font-bold text-white text-sm">{award.title}</h4>
                  <span class="text-xs text-[#9b9aaa] font-['JetBrains_Mono'] shrink-0">{award.date}</span>
                </div>
                <p class={`text-xs font-semibold mt-0.5 mb-1.5 ${colorMap[award.color].dot.replace('bg-', 'text-')}`}>{award.from}</p>
                <p class="text-sm text-[#9b9aaa]">{award.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
