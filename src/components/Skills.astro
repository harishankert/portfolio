---
const skillGroups = [
  {
    label: 'ServiceNow Platform',
    color: 'violet',
    icon: '⚙️',
    skills: ['ITSM', 'ITOM', 'CSM', 'HRSD', 'SecOps', 'Event Management', 'Discovery', 'Vulnerability Response', 'Flow Designer', 'IntegrationHub', 'Service Portal', 'Virtual Agent', 'Now Assist', 'Custom Scoped Apps'],
  },
  {
    label: 'AI & Automation',
    color: 'cyan',
    icon: '🤖',
    skills: ['Agentic AI Workflows', 'Autonomous Agent Dev', 'Generative AI', 'Prompt Engineering', 'AIOps', 'Now Assist', 'Vibe Coding', 'Machine Learning Ops'],
  },
  {
    label: 'Development',
    color: 'amber',
    icon: '💻',
    skills: ['JavaScript', 'Python', 'AngularJS', 'Node.js', 'HTML5', 'CSS3', 'Bootstrap 3', 'D3.js', 'React', 'PowerShell'],
  },
  {
    label: 'Integrations & DevOps',
    color: 'green',
    icon: '🔗',
    skills: ['REST APIs', 'SOAP', 'JDBC', 'SSH', 'Webhooks', 'MS Teams', 'Azure', 'Cloud Insights', 'Rapid7', 'OpsRamp'],
  },
];

const colorMap: Record<string, { bg: string; border: string; text: string; dot: string }> = {
  violet: { bg: 'bg-violet-500/10', border: 'border-violet-500/25', text: 'text-violet-300', dot: 'bg-violet-400' },
  cyan:   { bg: 'bg-cyan-500/10',   border: 'border-cyan-500/25',   text: 'text-cyan-300',   dot: 'bg-cyan-400' },
  amber:  { bg: 'bg-amber-500/10',  border: 'border-amber-500/25',  text: 'text-amber-300',  dot: 'bg-amber-400' },
  green:  { bg: 'bg-green-500/10',  border: 'border-green-500/25',  text: 'text-green-300',  dot: 'bg-green-400' },
};
---

<section id="skills" class="py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-500/30 bg-violet-500/10 text-violet-300 text-xs font-medium mb-6 font-['JetBrains_Mono'] uppercase tracking-widest">
        // skills
      </div>
      <h2 class="section-heading text-white">
        What I <span class="gradient-text">Bring</span> to the Table
      </h2>
      <p class="text-[#9b9aaa] mt-4 max-w-xl mx-auto">
        A decade of hands-on expertise spanning the full ServiceNow ecosystem, AI/ML engineering, and enterprise integrations.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {skillGroups.map((group, i) => {
        const c = colorMap[group.color];
        return (
          <div class={`reveal card-surface rounded-2xl p-7`} style={`transition-delay: ${i * 0.1}s`}>
            <div class="flex items-center gap-3 mb-6">
              <div class={`w-10 h-10 rounded-xl ${c.bg} border ${c.border} flex items-center justify-center text-xl shrink-0`}>
                {group.icon}
              </div>
              <h3 class="font-bold text-white text-lg">{group.label}</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg ${c.bg} border ${c.border} ${c.text} text-xs font-medium`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${c.dot}`}></span>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Proficiency bars -->
    <div class="mt-12 reveal card-surface rounded-2xl p-8">
      <h3 class="font-bold text-white text-lg mb-8 text-center">Core Proficiency</h3>
      <div class="grid md:grid-cols-2 gap-x-16 gap-y-5">
        {[
          { name: 'ServiceNow Platform', pct: 98, color: 'from-violet-500 to-violet-400' },
          { name: 'Agentic AI / Now Assist', pct: 90, color: 'from-cyan-500 to-cyan-400' },
          { name: 'JavaScript / AngularJS', pct: 88, color: 'from-amber-500 to-amber-400' },
          { name: 'Python', pct: 82, color: 'from-green-500 to-green-400' },
          { name: 'Enterprise Integrations', pct: 95, color: 'from-violet-500 to-cyan-400' },
          { name: 'Flow Designer / IntegrationHub', pct: 95, color: 'from-cyan-500 to-violet-400' },
          { name: 'ITSM / ITOM Architecture', pct: 96, color: 'from-amber-500 to-violet-400' },
          { name: 'Prompt Engineering', pct: 85, color: 'from-green-500 to-cyan-400' },
        ].map(({ name, pct, color }) => (
          <div>
            <div class="flex justify-between text-sm mb-2">
              <span class="text-[#9b9aaa]">{name}</span>
            </div>
            <div class="h-2 rounded-full bg-[#1a1a24] overflow-hidden">
              <div
                class={`h-full rounded-full bg-gradient-to-r ${color}`}
                style={`width: ${pct}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
